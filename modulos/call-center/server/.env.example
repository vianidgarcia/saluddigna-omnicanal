# Puerto del servidor WebSocket / HTTP del módulo Call Center
PORT=4010
CORS_ORIGIN=http://localhost:5178

# Conexión a Supabase (local o nube)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Service role se usa únicamente en el backend para abrir el canal de la Contestadora IA ('ia')
# y solicitar OTPs cuando aún no hay asesor asignado.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API (Contestadora IA) — usar modelo ligero para ahorrar cuota gratuita
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Límite de peticiones a Groq por minuto en el servidor (protección de cuota gratuita)
GROQ_MAX_RPM=20

# Voz neuronal gratuita (Edge TTS) en servidor: true | false (el navegador siempre tiene fallback local)
ENABLE_SERVER_TTS=false
TTS_VOICE=es-MX-DaliaNeural
