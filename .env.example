# Copia este archivo como .env.local. Ninguno de estos valores es secreto.

# local  → el portal funciona solo con datos simulados (localStorage). No necesita backend.
# api    → el portal usa el orquestador omnicanal (repo hackathon-puebla) en Supabase.
# Si falta este valor, el portal arranca en "local": la demo nunca se queda sin funcionar.
VITE_MODO=local

# Solo para VITE_MODO=api. Salen de `npx supabase status` (local) o del panel del proyecto.
# La clave PUBLICABLE es pública y puede ir al navegador. La clave SECRETA nunca va aquí.
# Estos son los del proyecto del equipo, hackathon-omnicanal (docs/GUIA_APP_PWA.md).
VITE_SUPABASE_URL=https://bdkjkmynxaphqcnapmjk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wrZ4EDTapWIzEm9WMowSSg_GG653EUj

# Servidor del call center (modulos/call-center). Solo modo api; vacío = sin llamadas desde el portal.
# Ej. ws://localhost:4010/ws en local, wss://… publicado (el micrófono exige HTTPS).
VITE_CALL_CENTER_URL=


